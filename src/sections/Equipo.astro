---
import SectionHead from '../components/SectionHead.astro';
const team = [
  { area: 'Alternativas y emplazamiento', who: ['Carlos López Parga', 'Nicolás Jiménez-Carlés Parga'], what: 'Seis configuraciones, cinco municipios y la decisión de co-ubicar la planta con El Tejar.' },
  { area: 'Estudio económico', who: ['Ignacio Tubío Ríos', 'Nicolás Ferreiro Gil'], what: 'Mercado, precios, escenarios y financiación por fases.' },
  { area: 'Modelo de cálculo', who: ['Pablo Javier Sánchez Lomba', 'Darío González Cuello de Oro'], what: 'El modelo que alimenta el simulador y su revisión.' },
  { area: 'Memoria técnica', who: ['Alberto Gómez Serrano', 'Diego Merino García'], what: 'Proceso, equipos, planos, presupuesto y tramitación.' }
];
---
<section id="equipo" class="sec on-paper team" aria-labelledby="equipo-h">
  <div class="wrap">
    <SectionHead n="12" name="Equipo" id="equipo" title="Ocho ingenieros industriales"
      lede="OLEACARB es el proyecto del grupo T1 de la asignatura Proyectos del Grado en Ingeniería en Tecnologías Industriales de la ETSII, Universidad Politécnica de Madrid, curso 2026-27, con el profesor Francisco Javier Sánchez como promotor." />
    <div class="firmas" role="table" aria-label="Cajetín de firmas del proyecto">
      <div class="f-row f-head" role="row">
        <span role="columnheader">N.º</span><span role="columnheader">Área</span><span role="columnheader">Integrantes</span><span role="columnheader">Qué hicieron</span>
      </div>
      {team.map((t, i) => (
        <div class="f-row" role="row">
          <span class="f-n mono" role="cell">{String(i + 1).padStart(2, '0')}</span>
          <span class="f-a" role="cell">{t.area}</span>
          <span class="f-w" role="cell">{t.who.map(w => <span>{w}</span>)}</span>
          <span class="f-d" role="cell">{t.what}</span>
        </div>
      ))}
      <div class="f-row f-foot" role="row">
        <span role="cell" class="mono">T1</span>
        <span role="cell">Proyectos (55000037) · GITI · ETSII-UPM</span>
        <span role="cell">Promotor: Francisco Javier Sánchez</span>
        <span role="cell" class="mono">Madrid, noviembre de 2026</span>
      </div>
    </div>
  </div>
</section>
<style>
  @layer sections {
    .firmas { border: 2px solid var(--ink); background: var(--surface); }
    .f-row { display: grid; grid-template-columns: 64px minmax(0, 3fr) minmax(0, 3.2fr) minmax(0, 4fr); }
    .f-row > span { padding: 16px 18px; border-right: 1px solid var(--ink); }
    .f-row > span:last-child { border-right: 0; }
    .f-row + .f-row { border-top: 1px solid var(--ink); }
    .f-head > span { font: 500 12px var(--f-mono); color: var(--muted); padding-block: 10px; }
    .f-n { font-size: 14px; color: var(--muted); }
    .f-a { font: 600 clamp(19px, 1.7vw, 23px)/1.25 var(--f-serif); }
    .f-w { display: grid; gap: 2px; font-size: 16px; font-weight: 500; }
    .f-d { color: var(--muted); font-size: 15px; }
    .f-foot > span { font-size: 13.5px; color: var(--ink); padding-block: 10px; }
    .f-foot .mono { font-size: 12.5px; }
    @media (max-width: 860px) {
      .f-head { display: none; }
      .f-row { grid-template-columns: 44px minmax(0, 1fr); }
      .f-row > span { border-right: 0; padding: 4px 14px; }
      .f-n { grid-row: 1 / 4; border-right: 1px solid var(--ink) !important; padding-top: 16px !important; }
      .f-a { padding-top: 14px !important; }
      .f-d { padding-bottom: 14px !important; }
      .f-foot > span:first-child { grid-row: 1 / 5; border-right: 1px solid var(--ink) !important; }
      .f-foot > span { padding: 4px 14px; }
    }
  }
</style>
