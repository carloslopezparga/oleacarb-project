---
import SectionHead from '../components/SectionHead.astro';
import Cajetin from '../components/Cajetin.astro';
import { timeline, monthLabel } from '../lib/data';
import { num, THIN } from '../lib/format';

const A = timeline.activities;
const PH = timeline.phases;
const M = 84;                                   // meses de enero de 2027 a diciembre de 2033
// --- Gantt de escritorio ---
const G = { w: 1240, lx: 392, rx: 1228, top: 64, row: 24 };
const xm = (m: number) => G.lx + (m / M) * (G.rx - G.lx);
const gh = G.top + A.length * G.row + 16;
const phaseBands = [
  { name: 'Fase 0', a: 0, b: 12, cls: 'ph0' }, { name: 'Fase 1', a: 12, b: 36, cls: 'ph1' },
  { name: 'Fase 2 · obra', a: 36, b: 60, cls: 'ph2' }, { name: 'Arranque y rampa', a: 60, b: 84, cls: 'ph3' }
];
const gates = [
  { id: 'H1', m: 12, name: 'Hito 1', date: 'dic-2027' },
  { id: 'H2', m: 36, name: 'Hito 2', date: 'dic-2029' },
  { id: 'X', m: 60, name: 'Arranque', date: 'ene-2032' }
];
// --- Gantt simplificado del móvil ---
const S = { w: 360, lx: 8, rx: 352, top: 34 };
const xs = (m: number) => S.lx + (m / M) * (S.rx - S.lx);
// --- capital acumulado (timeline.json → phases.cumulative_Meur): 0,6 · 3,7 · 65,3 M€, con eje partido ---
const cap = PH.filter(p => p.cumulative_Meur !== undefined) as { name: string; years: string; cumulative_Meur: number }[];
const C = { w: 360, h: 270, lx: 46, rx: 344, lowTop: 150, lowBot: 230, hiTop: 34, hiBot: 92 };
const yLow = (v: number) => C.lowBot - (v / 4) * (C.lowBot - C.lowTop);          // 0–4 M€
const yHi = (v: number) => C.hiBot - ((v - 62) / 4) * (C.hiBot - C.hiTop);        // 62–66 M€
const xc = (yr: number) => C.lx + ((yr - 2027) / 5) * (C.rx - C.lx);              // 2027 → 2032
const yrs = [2027, 2028, 2029, 2030, 2031, 2032];
const msText = timeline.milestones;
---
<section id="calendario" class="sec sheet on-paper cal" aria-labelledby="calendario-h">
  <div class="wrap">
    <SectionHead n="08" name="Calendario" id="calendario" title="3,7&#8239;M€ en juego antes de decidir construir"
      lede="La inversión va por fases. Cada fase termina en un hito que funciona como una puerta: si no se cumple, el proyecto se para y solo se ha gastado el capital de las fases anteriores." />

    <div class="cal-top">
      <figure class="capital" aria-labelledby="cap-cap">
        <svg viewBox={`0 0 ${C.w} ${C.h}`} role="img" aria-label="Capital comprometido acumulado: 0,6 M€ en 2027, 3,7 M€ en 2028 y 2029 y 65,3 M€ desde 2030. Eje vertical partido entre 4 y 62 M€.">
          <!-- eje partido: dos tramos con la marca de corte -->
          {[0, 2, 4].map(v => <><line x1={C.lx} x2={C.rx} y1={yLow(v)} y2={yLow(v)} class="grid" /><text x={C.lx - 8} y={yLow(v) + 4} class="ax" text-anchor="end">{num(v)}</text></>)}
          {[62, 64, 66].map(v => <><line x1={C.lx} x2={C.rx} y1={yHi(v)} y2={yHi(v)} class="grid" /><text x={C.lx - 8} y={yHi(v) + 4} class="ax" text-anchor="end">{num(v)}</text></>)}
          <g class="brk"><path d={`M${C.lx - 6},${C.hiBot + 18} l12,-6 M${C.lx - 6},${C.hiBot + 26} l12,-6`} /><path d={`M${C.rx - 6},${C.hiBot + 18} l12,-6 M${C.rx - 6},${C.hiBot + 26} l12,-6`} /></g>
          <text x={C.lx + 12} y={C.hiBot + 27} class="brk-t">eje partido</text>
          <!-- escalones -->
          <path class="step lo" d={`M${xc(2027)},${yLow(0)} V${yLow(0.6)} H${xc(2028)} V${yLow(3.7)} H${xc(2030)} V${C.lowTop - 4}`} />
          <path class="step hi" d={`M${xc(2030)},${C.hiBot + 4} V${yHi(65.3)} H${xc(2032)}`} />
          <circle cx={xc(2027.5)} cy={yLow(0.6)} r="4" class="dot" /><text x={xc(2027.5)} y={yLow(0.6) - 9} class="val" text-anchor="middle">{num(0.6, 1)}</text>
          <circle cx={xc(2029)} cy={yLow(3.7)} r="4" class="dot d2" /><text x={xc(2029)} y={yLow(3.7) - 9} class="val v2" text-anchor="middle">{num(3.7, 1)}</text>
          <circle cx={xc(2031)} cy={yHi(65.3)} r="4" class="dot" /><text x={xc(2031)} y={yHi(65.3) - 9} class="val" text-anchor="middle">{num(65.3, 1)}</text>
          {yrs.map(y => <text x={xc(y)} y={C.h - 16} class="ax" text-anchor="middle">{y}</text>)}
          <text x={C.lx - 8} y="16" class="ax">M€</text>
          <line x1={xc(2030)} x2={xc(2030)} y1={C.hiTop - 10} y2={C.lowBot} class="gate-l" />
          <text x={xc(2030) - 6} y={C.hiTop - 14} class="ax gate-t" text-anchor="end">Hito 2</text>
        </svg>
        <figcaption id="cap-cap">
          <p class="cap-big"><span class="num">{num(3.7, 1)}</span><small>{THIN}M€</small></p>
          <p>Si el Hito 2 no se cumple, se para con {num(3.7, 1)}{THIN}M€ gastados y no con {num(65.3, 1)}.</p>
          <ul class="ph-list" role="list">
            {cap.map(p => <li><span class="mono">{p.years}</span><span>{p.name}</span><b class="num">{num(p.cumulative_Meur, 1)}{THIN}M€</b></li>)}
          </ul>
        </figcaption>
      </figure>

      <ol class="gates" role="list">
        {msText.map((m, i) => (
          <li class={`gate g${i}`}>
            <p class="gate-h"><span class="dia" aria-hidden="true"></span><b>{m.name}</b><span class="mono">{m.date === '2027-12' ? 'dic-2027' : m.date === '2029-12' ? 'dic-2029' : 'ene-2032'}</span></p>
            <p>{m.text}</p>
          </li>
        ))}
      </ol>
    </div>

    <figure class="gantt field">
      <svg class="g-lg" viewBox={`0 0 ${G.w} ${gh}`} role="img" aria-label="Diagrama de Gantt de las 25 actividades del proyecto, de enero de 2027 a diciembre de 2033, con el camino crítico en terracota, las holguras como bigotes y los hitos de decisión.">
        {phaseBands.map(p => <rect x={xm(p.a)} y={G.top - 8} width={xm(p.b) - xm(p.a)} height={gh - G.top} class={`phb ${p.cls}`} />)}
        {phaseBands.map(p => <text x={xm(p.a) + 6} y={G.top - 16} class="ph-t">{p.name}</text>)}
        {Array.from({ length: 7 }, (_, i) => <><line x1={xm(i * 12)} x2={xm(i * 12)} y1={22} y2={gh} class="yr-l" /><text x={xm(i * 12) + 4} y={20} class="yr-t">{2027 + i}</text></>)}
        {A.map((a, i) => {
          const y = G.top + i * G.row;
          const ms = a.d === 0;
          return (
            <g class={`act ${a.crit ? 'crit' : ''} ${ms ? 'ms' : ''}`} style={`--i:${i}`}>
              <text x="8" y={y + 16} class="a-id">{a.id}</text>
              <text x="40" y={y + 16} class="a-n">{a.name}</text>
              {ms
                ? <rect x={xm(a.es) - 6} y={y + 6} width="12" height="12" transform={`rotate(45 ${xm(a.es)} ${y + 12})`} class="dia" />
                : <rect x={xm(a.es)} y={y + 5} width={xm(a.ef) - xm(a.es)} height="14" class="bar" />}
              {a.slack > 0 && <><line x1={xm(a.ef)} x2={xm(a.lf)} y1={y + 12} y2={y + 12} class="slack" /><line x1={xm(a.lf)} x2={xm(a.lf)} y1={y + 7} y2={y + 17} class="slack" /></>}
              {!ms && <text x={xm(a.lf) + 6} y={y + 16} class="a-d">{a.d}{THIN}m</text>}
              {ms && <text x={xm(a.es) + 12} y={y + 16} class="a-ms">{monthLabel(a.es === 60 ? 60 : a.es - 1)}</text>}
            </g>
          );
        })}
        {gates.map(g => <line x1={xm(g.m)} x2={xm(g.m)} y1={G.top - 8} y2={gh} class="gate-v" />)}
      </svg>

      <svg class="g-sm" viewBox={`0 0 ${S.w} 250`} role="img" aria-label="Fases del proyecto e hitos: Fase 0 en 2027, Fase 1 en 2028 y 2029, Fase 2 de obra en 2030 y 2031, arranque en enero de 2032 y rampa hasta 2033.">
        {Array.from({ length: 7 }, (_, i) => <><line x1={xs(i * 12)} x2={xs(i * 12)} y1="22" y2="200" class="yr-l" /><text x={xs(i * 12) + 2} y="16" class="yr-t s">{String(2027 + i).slice(2)}</text></>)}
        {phaseBands.map((p, i) => <><rect x={xs(p.a)} y={S.top + i * 38} width={xs(p.b) - xs(p.a)} height="22" class={`phs ${p.cls}`} /><text x={p.a < 40 ? xs(p.b) + 6 : xs(p.a) - 6} y={S.top + i * 38 + 16} class="phs-t" text-anchor={p.a < 40 ? 'start' : 'end'}>{p.name}</text></>)}
        {gates.map(g => <><line x1={xs(g.m)} x2={xs(g.m)} y1="22" y2="200" class="gate-v" /><rect x={xs(g.m) - 6} y="200" width="12" height="12" transform={`rotate(45 ${xs(g.m)} 206)`} class="dia" /><text x={xs(g.m)} y="234" text-anchor="middle" class="g-t">{g.name}</text><text x={xs(g.m)} y="248" text-anchor="middle" class="g-d">{g.date}</text></>)}
      </svg>
      <figcaption class="g-leg">
        <span class="lg-full"><i class="lg-bar"></i>actividad</span><span class="lg-full"><i class="lg-crit"></i>camino crítico</span><span class="lg-full"><i class="lg-slack"></i>holgura</span><span><i class="lg-dia"></i>hito de decisión</span>
        <span class="src">Meses desde enero de 2027. CPM de la memoria (capítulo 16).</span>
      </figcaption>
      <details class="as-table g-all">
        <summary>Ver todas las actividades</summary>
        <ol class="acts" role="list">
          {A.map(a => (
            <li class={a.crit ? 'crit' : ''}>
              <span class="mono a-id">{a.id}</span>
              <span class="a-name">{a.name}{a.crit && <em> · crítica</em>}</span>
              <span class="a-when mono">{a.d === 0 ? monthLabel(a.es === 60 ? 60 : a.es - 1) : `${monthLabel(a.es)} → ${monthLabel(a.ef - 1)} · ${a.d} m`}{a.slack ? ` · holgura ${a.slack} m` : ''}</span>
              <span class="a-track" aria-hidden="true"><i style={`left:${(a.es / M * 100).toFixed(2)}%;width:${Math.max(1.2, a.d / M * 100).toFixed(2)}%`}></i></span>
            </li>
          ))}
        </ol>
      </details>
    </figure>
    <Cajetin code="PL-01" title="Planificación por fases" scale="meses" />
  </div>
</section>

<style>
  @layer sections {
    .cal-top { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(28px, 4vw, 64px); align-items: start; margin-bottom: clamp(40px, 5vw, 64px); }
    .capital { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 24px; align-items: start; }
    .capital svg { width: 100%; max-width: 440px; height: auto; background: var(--surface); border: 1px solid var(--rule); }
    .capital .grid { stroke: var(--rule-2); stroke-width: 1; }
    .capital .ax { font: 500 12px var(--f-mono); fill: var(--muted); }
    .brk path { stroke: var(--ink); stroke-width: 1.4; fill: none; }
    .brk-t { font: 500 11.5px var(--f-mono); fill: var(--ink); }
    .step { fill: none; stroke: var(--ink); stroke-width: 2.4; stroke-linejoin: round; }
    .step.hi { stroke: var(--terra); }
    .dot { fill: var(--ink); } .dot.d2 { fill: var(--olive); }
    .val { font: 600 15px var(--f-serif); fill: var(--ink); } .val.v2 { fill: var(--olive-d); }
    .gate-l { stroke: var(--terra); stroke-width: 1.2; stroke-dasharray: 4 3; }
    .gate-t { fill: var(--terra); }
    .cap-big { font: 600 clamp(64px, 8vw, 120px)/.9 var(--f-serif); font-variation-settings: 'opsz' 60; letter-spacing: -.03em; color: var(--olive-d); }
    .cap-big small { font-size: .32em; letter-spacing: 0; color: var(--ink); }
    .capital figcaption { display: grid; gap: 14px; }
    .capital figcaption > p:not(.cap-big) { font: 400 19px/1.45 var(--f-serif); }
    .ph-list { display: grid; margin: 0; font-size: 14px; border-top: 1px solid var(--ink); }
    .ph-list li { display: grid; grid-template-columns: 76px minmax(0, 1fr) auto; gap: 8px; padding: 7px 0; border-bottom: 1px solid var(--rule); }
    .ph-list .mono { font-size: 12.5px; color: var(--muted); }

    .gates { display: grid; gap: 0; margin: 0; border-top: 2px solid var(--ink); }
    .gate { padding: 14px 0 16px; border-bottom: 1px solid var(--rule); display: grid; gap: 6px; font-size: 15px; }
    .gate-h { display: flex; align-items: center; gap: 10px; }
    .gate-h b { font: 600 22px var(--f-serif); }
    .gate-h .mono { font-size: 13px; color: var(--muted); margin-left: auto; }
    .gate .dia { width: 12px; height: 12px; background: var(--terra); transform: rotate(45deg); display: inline-block; }
    .gate.g2 .dia { background: var(--ion-d); }

    .gantt { padding: clamp(12px, 2vw, 22px); }
    .gantt svg { width: 100%; height: auto; }
    .g-sm { display: none; }
    .phb { opacity: .55; } .phb.ph0 { fill: var(--ochre-p); } .phb.ph1 { fill: var(--olive-p); } .phb.ph2 { fill: var(--rule-2); } .phb.ph3 { fill: var(--ion-p); }
    .ph-t { font: 600 13px var(--f-cond); fill: var(--ink); }
    .yr-l { stroke: var(--rule); stroke-width: 1; }
    .yr-t { font: 500 12.5px var(--f-mono); fill: var(--ink); }
    .a-id { font: 500 12.5px var(--f-mono); fill: var(--muted); }
    .a-n { font: 400 13.5px var(--f-sans); fill: var(--ink); }
    .crit .a-id { fill: var(--terra); font-weight: 600; }
    .crit .a-n { font-weight: 600; }
    .bar { fill: var(--olive); transform-box: fill-box; transform-origin: 0 50%; transition: transform 240ms var(--ease-out); transition-delay: calc(var(--i) * 22ms); }
    .crit .bar { fill: var(--terra); }
    :global(.js) .gantt:not(.is-in) .bar { transform: scaleX(0); }
    .slack { stroke: var(--muted); stroke-width: 1.2; }
    .a-d { font: 500 11.5px var(--f-mono); fill: var(--muted); }
    .dia { fill: var(--terra); }
    .a-ms { font: 600 12.5px var(--f-mono); fill: var(--terra); }
    .gate-v { stroke: var(--terra); stroke-width: 1.2; stroke-dasharray: 5 4; }
    .g-leg { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; margin-top: 12px; font-size: 13px; }
    .g-leg i { display: inline-block; vertical-align: -1px; margin-right: 6px; }
    .lg-bar { width: 22px; height: 10px; background: var(--olive); } .lg-crit { width: 22px; height: 10px; background: var(--terra); }
    .lg-slack { width: 22px; height: 0; border-top: 1.5px solid var(--muted); vertical-align: 3px !important; }
    .lg-dia { width: 10px; height: 10px; background: var(--terra); transform: rotate(45deg); }
    .g-leg .src { margin-left: auto; }
    .g-all { display: none; }
    .acts { display: grid; margin: 8px 0 0; }
    .acts li { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 2px 8px; padding: 9px 0; border-top: 1px solid var(--rule-2); font-size: 14px; }
    .acts .a-id { font-size: 12.5px; color: var(--muted); grid-row: 1 / 3; padding-top: 2px; }
    .acts .crit .a-id { color: var(--terra); font-weight: 600; }
    .acts em { font-style: normal; color: var(--terra); font-weight: 500; }
    .a-when { font-size: 12px; color: var(--muted); }
    .a-track { grid-column: 2; position: relative; height: 6px; background: var(--rule-2); margin-top: 4px; }
    .a-track i { position: absolute; top: 0; bottom: 0; background: var(--olive); }
    .acts .crit .a-track i { background: var(--terra); }

    @media (max-width: 1000px) { .cal-top { grid-template-columns: minmax(0, 1fr); } }
    @media (max-width: 760px) {
      .capital { grid-template-columns: minmax(0, 1fr); }
      .capital svg { max-width: none; }
      .g-lg { display: none; }
      .g-sm { display: block; }
      .g-all { display: block; }
      .g-leg .src { margin-left: 0; }
      .lg-full { display: none; }
      .phs.ph0 { fill: var(--ochre); } .phs.ph1 { fill: var(--olive); } .phs.ph2 { fill: var(--olive-d); } .phs.ph3 { fill: var(--ion-d); }
    }
    .phs.ph0 { fill: var(--ochre); } .phs.ph1 { fill: var(--olive); } .phs.ph2 { fill: var(--olive-d); } .phs.ph3 { fill: var(--ion-d); }
    .phs-t { font: 600 13px var(--f-cond); fill: var(--ink); }
    .yr-t.s { font-size: 12px; }
    .g-t { font: 600 13px var(--f-cond); fill: var(--terra); }
    .g-d { font: 500 12px var(--f-mono); fill: var(--ink); }
  }
</style>
