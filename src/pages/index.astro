---
import Base from '../layouts/Base.astro';
import Hero from '../sections/Hero.astro';
import Reto from '../sections/Reto.astro';
import Territorio from '../sections/Territorio.astro';
import Viaje from '../sections/Viaje.astro';
import Proceso from '../sections/Proceso.astro';
import Planta from '../sections/Planta.astro';
import Balances from '../sections/Balances.astro';
import Calendario from '../sections/Calendario.astro';
import Simulador from '../sections/Simulador.astro';
import Impacto from '../sections/Impacto.astro';
import Video from '../sections/Video.astro';
import Equipo from '../sections/Equipo.astro';
import Fuentes from '../sections/Fuentes.astro';
---
<Base title="OLEACARB · Del hueso de aceituna al ánodo de las baterías de sodio"
  description="Planta en Mancha Real (Jaén) que convierte hueso de aceituna en hard carbon para el ánodo de las baterías de ion-sodio. Proceso, planta, balances y simulador financiero en vivo.">
  <main id="main">
    <Hero />
    <Reto />
    <Territorio />
    <Viaje />
    <Proceso />
    <Planta />
    <Balances />
    <Calendario />
    <Simulador />
    <Impacto />
    <Video />
    <Equipo />
    <Fuentes />
  </main>
</Base>

<script>
  import { initMotion, whenNear } from '../lib/motion';
  import { settleInitialHash, bindAnchorLinks, bindSectionKeys } from '../lib/anchors';
  import { initHero } from '../scripts/hero';
  import { initInView } from '../scripts/inview';
  import { initViaje } from '../scripts/viaje';
  import { initProceso } from '../scripts/proceso';
  import { initPlanta } from '../scripts/planta';

  initMotion();
  bindAnchorLinks();
  bindSectionKeys();
  initHero();
  initInView();
  initViaje();
  // Proceso y planta solo se activan cuando se acercan a la pantalla (o si el QR apunta a ellas).
  const lazy = (id: string, fn: () => void) => {
    const el = document.getElementById(id);
    if (!el) return;
    if (location.hash === '#' + id) fn(); else whenNear(el, fn, '900px 0px');
  };
  lazy('proceso', initProceso);
  lazy('planta', initPlanta);
  settleInitialHash();
</script>
