  <g transform="rotate(-32 50 50)"><path d="M50,5 C81,27 81,73 50,95 C19,73 19,27 50,5 Z" fill="#5B6B2E" /></g>
  <polygon points="63.42,57.75 50.00,65.50 36.58,57.75 36.58,42.25 50.00,34.50 63.42,42.25" fill="none" stroke="#F7F5EF" stroke-width="3.2" />
  <circle cx="50" cy="50" r="4.8" fill="#16AEBF" />
</svg>
